# Gemini Live & Google Cloud configuration
# WARNING: Do NOT bake a real NEXT_PUBLIC_GEMINI_API_KEY into public static builds
# (next build with output: 'export'). For public deployments, leave it blank and
# enter your API key in the browser top bar (stored locally in localStorage).
NEXT_PUBLIC_GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Rust Robot Bridge (:9000 on ROSOrin Pro Jetson Orin Nano or localhost mock)
NEXT_PUBLIC_BRIDGE_URL=http://localhost:9000
BRIDGE_PORT=9000
# Optional shared token for authenticating mutating POST/WS requests on LAN Wi-Fi:
BRIDGE_TOKEN=
NEXT_PUBLIC_BRIDGE_TOKEN=
ROBOT_BACKEND=mock
SERIAL_PORT=/dev/rrc
SERIAL_BAUD=1000000
CMD_VEL_WATCHDOG_MS=600
