# Variables que lee la web (Next.js). Copia este archivo a web/.env.local para `npm run dev`.
# Todo lo que empieza con NEXT_PUBLIC_ se incrusta en el bundle del navegador al compilar.
# Las variables del bridge en Rust (BRIDGE_TOKEN, ROBOT_BACKEND, puertos, etc.) están en
# robot-bridge/.env.example: la web no las lee.

# API key de Gemini SOLO para desarrollo local con `npm run dev`.
# No hagas `npm run build` ni despliegues con este valor: el sitio es un export estático y la clave
# quedaría pública. En el sitio público se pega en el navegador (se guarda en localStorage).
NEXT_PUBLIC_GEMINI_API_KEY=

# Modelo de Gemini Live.
NEXT_PUBLIC_GEMINI_LIVE_MODEL=gemini-3.8-live

# URL del bridge (run.sh la define sola). El token del bridge NUNCA va en una variable NEXT_PUBLIC_*:
# abre la web una vez con #token=<t> (lo imprime run.sh; ?token=<t> también funciona) o pégalo en el
# panel del robot de la barra superior. Si cambias a otro host del bridge, la web borra el token.
NEXT_PUBLIC_BRIDGE_URL=http://localhost:9000

# 1 = modo ligero sin gemelo 3D (lo usa run.sh en el robot). Vacío = normal.
NEXT_PUBLIC_LITE_MODE=
