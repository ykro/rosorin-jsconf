# Variables que lee robot-bridge (Rust) y scripts/ros2_worker.py.
# El puente no carga .env solo: cópialo a .env, edítalo y expórtalo con
#   set -a; source robot-bridge/.env; set +a
# Cada variable equivale a un flag de línea de comandos (entre paréntesis).

# Dirección de escucha (--host). Por defecto solo loopback.
# Si no es loopback (p. ej. 0.0.0.0) el puente exige BRIDGE_TOKEN y se niega a arrancar sin él
# (salvo con --insecure-no-token, que no recomendamos).
BRIDGE_HOST=127.0.0.1

# Puerto HTTP/WebSocket (--port).
BRIDGE_PORT=9000

# Token compartido (--token). Si está definido se exige en todas las rutas salvo GET /health
# y el preflight OPTIONS: header "Authorization: Bearer <token>" o "x-bridge-token: <token>";
# en /ws también se acepta ?token=<token>. Genera uno con: openssl rand -hex 16
# ./run.sh lo genera solo en el robot y lo guarda en .bridge-token (permisos 600).
BRIDGE_TOKEN=

# Orígenes extra permitidos en CORS/WebSocket, exactos y separados por comas (--allowed-origins).
# Ya se permiten: IPs de loopback o privadas, localhost, jsconfmx26.web.app y jsconfmx26.firebaseapp.com.
BRIDGE_ALLOWED_ORIGINS=

# Nombres extra aceptados en el header Host, separados por comas (--allowed-hosts), p. ej. rosorin.local.
# Ya se aceptan cualquier IP literal y localhost (protección contra DNS rebinding).
BRIDGE_ALLOWED_HOSTS=

# Backend (--backend): mock | serial | ros2. Si pides serial o ros2 y falla, el puente sale con
# error; para caer a mock en silencio agrega --allow-mock-fallback (run.sh lo hace al autodetectar).
ROBOT_BACKEND=mock

# Puerto serie del STM32 para el backend serial (--serial-port) y su velocidad (--baud).
# Ojo: el backend serial no tiene LiDAR; la velocidad lineal se limita a 0.15 m/s.
SERIAL_PORT=/dev/rrc
SERIAL_BAUD=1000000

# Watchdog del chasis en ms (--watchdog-ms): sin comandos nuevos ni duration_ms vigente, el robot se detiene.
CMD_VEL_WATCHDOG_MS=600

# Ruta a ros2_worker.py (--worker-path). Por defecto se busca junto al crate (robot-bridge/scripts),
# nunca relativa al directorio actual.
ROS2_WORKER_PATH=

# --- ros2_worker.py: filtro de la sombra del brazo en el LiDAR ---
# Los ecos más cercanos que ARM_SHADOW_MAX_M (metros) dentro de ±ARM_SHADOW_HALF_ANGLE_DEG grados
# al frente se consideran el propio brazo. Si en un sector solo quedan ecos filtrados, se reporta
# el más cercano (falla cerrado). Calíbralo en el robot con `ros2 topic echo /scan`; 0 lo desactiva.
ARM_SHADOW_MAX_M=0.12
ARM_SHADOW_HALF_ANGLE_DEG=35

# Logs del puente (tracing). Ejemplo: rosorin_bridge=debug,tower_http=info
RUST_LOG=rosorin_bridge=info,tower_http=info
