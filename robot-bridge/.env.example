# Variables que leen robot-bridge (Rust), scripts/ros2_worker.py y scripts/robot-common.sh.
# El puente no carga .env solo: cópialo a .env, edítalo y expórtalo con
#   set -a; source robot-bridge/.env; set +a
# Las del bridge equivalen a un flag de línea de comandos (entre paréntesis). El bridge le pasa su
# entorno a ros2_worker.py, así que las del worker también se definen al levantar el bridge.

# Dirección de escucha (--host). Por defecto solo loopback.
# Si no es loopback (p. ej. 0.0.0.0) el puente exige BRIDGE_TOKEN y se niega a arrancar sin él
# (salvo con --insecure-no-token, que no recomendamos).
BRIDGE_HOST=127.0.0.1

# Puerto HTTP/WebSocket (--port).
BRIDGE_PORT=9000

# Token compartido (--token). Si está definido se exige en todas las rutas salvo GET /health
# y el preflight OPTIONS: header "Authorization: Bearer <token>" o "x-bridge-token: <token>";
# en /ws también se acepta ?token=<token>. Genera uno con: openssl rand -hex 16
# ./run.sh lo genera solo en el robot y lo guarda en .bridge-token (permisos 600);
# en la laptop, ./traer-token.sh <usuario>@<IP> lo trae por SSH.
BRIDGE_TOKEN=

# Orígenes extra permitidos en CORS/WebSocket, exactos y separados por comas (--allowed-origins).
# Ya se permiten: IPs de loopback, localhost, jsconfmx26.web.app y jsconfmx26.firebaseapp.com.
# Las IPs privadas (10/8, 172.16/12, 192.168/16) solo con BRIDGE_TOKEN o con BRIDGE_HOST fuera de
# loopback: un bridge en 127.0.0.1 sin token las rechaza.
BRIDGE_ALLOWED_ORIGINS=

# Nombres extra aceptados en el header Host, separados por comas (--allowed-hosts), p. ej. rosorin.local.
# Ya se aceptan cualquier IP literal y localhost (protección contra DNS rebinding).
BRIDGE_ALLOWED_HOSTS=

# Backend (--backend): mock | serial | ros2. Si pides serial o ros2 y falla, el puente sale con
# error; para caer a mock en silencio agrega --allow-mock-fallback (run.sh lo hace al autodetectar).
ROBOT_BACKEND=mock

# Puerto serie del STM32 para el backend serial (--serial-port) y su velocidad (--baud).
# Ojo: el backend serial no tiene LiDAR; la velocidad lineal se limita a 0.15 m/s.
SERIAL_PORT=/dev/rrc
SERIAL_BAUD=1000000

# Watchdog del chasis en ms (--watchdog-ms): sin comandos nuevos ni duration_ms vigente, el robot se detiene.
CMD_VEL_WATCHDOG_MS=600

# Ruta a ros2_worker.py (--worker-path). Por defecto se busca junto al crate (robot-bridge/scripts),
# nunca relativa al directorio actual.
ROS2_WORKER_PATH=

# --- ros2_worker.py: filtro de la sombra del brazo en el LiDAR ---
# Los ecos entre ARM_SHADOW_MIN_M y ARM_SHADOW_MAX_M (metros) dentro de ±ARM_SHADOW_HALF_ANGLE_DEG
# grados al frente se consideran el propio brazo y se ignoran si el sector tiene otros rayos
# utilizables (eco o espacio libre). Si el brazo es lo único que ve el sector, se reporta (bloquea).
# Lo que está más cerca que ARM_SHADOW_MIN_M siempre bloquea.
# Precedencia: estas variables > archivo de calibración (ARM_SHADOW_FILE) > valores por defecto
# (0.06–0.09 m, ±20°), estrechos y sin calibrar: si tu brazo cae fuera de la banda, el frente queda
# bloqueado. Calíbralo en el robot con `make calibrar-sombra` (con make robot corriendo), que escribe
# el archivo. ARM_SHADOW_MAX_M=0 desactiva el filtro. Déjalas comentadas para usar el archivo.
# ARM_SHADOW_MIN_M=0.06
# ARM_SHADOW_MAX_M=0.09
# ARM_SHADOW_HALF_ANGLE_DEG=20

# Archivo de calibración de la sombra que escribe `make calibrar-sombra` y lee el worker al arrancar.
# Por defecto: robot-bridge/arm-shadow.json (fuera de git: es de cada robot).
# ARM_SHADOW_FILE=

# --- ros2_worker.py: sectores ciegos del LiDAR ---
# Fracción mínima de rayos utilizables para confiar en un sector (REP 117: eco dentro de
# [range_min, range_max] o espacio libre, +inf o > range_max; NaN, -inf, 0 o < range_min son
# inválidos). Por debajo, el sector se reporta en 0.0 m y bloquea el avance hacia ese lado: un LiDAR
# tapado o sucio bloquea, un escenario abierto no. Un sector sin ningún rayo (recortado por el
# driver, como atrás en el ROSOrin Pro) se reporta en lidar.uncovered: vale 0.0 m pero no frena. 0 desactiva la revisión (un LiDAR tapado ya no
# bloquearía; el worker lo avisa en stderr).
LIDAR_MIN_VALID_FRACTION=0.25

# --- ros2_worker.py: orientación del /scan ---
# Si el ángulo 0 del driver no es el frente del robot (REP-103: 0 = frente, positivo = izquierda).
# ensayo.sh (sección 3) te dice cuál necesitas. LIDAR_FLIP=1 refleja el scan (izquierda y derecha
# cambiadas) y luego se suma LIDAR_ANGLE_OFFSET_DEG (180 si frente y atrás están cambiados).
# Precedencia: estas variables > archivo del robot (LIDAR_MOUNT_FILE) > 0 sin reflejar. Déjalas
# comentadas para usar el archivo.
# LIDAR_ANGLE_OFFSET_DEG=0
# LIDAR_FLIP=0

# Orientación guardada de cada robot ({"offset_deg": 180, "flip": false}). `make calibrar-sombra`
# ofrece escribirlo cuando /scan casi no cubre el frente. Por defecto: robot-bridge/lidar-mount.json
# (fuera de git).
# LIDAR_MOUNT_FILE=

# «Reconocer» (POST /scan_env, scripts/scan_env.py). Si las bandejas y los tótems están sobre una
# superficie más alta (+) o más baja (-) que la del robot, en metros. Por defecto 0: la misma mesa.
# SCAN_ENV_PROPS_HEIGHT_M=0
# Carpeta donde el worker guarda cada captura (JPEG si hay cv2, más un JSON con lo que encontró) para
# ajustar los umbrales de color en el robot. Vacía = no guarda nada.
# SCAN_ENV_DEBUG_DIR=

# --- run.sh, iniciar-robot.sh (robot-bridge/scripts/robot-common.sh) ---
# Candado de E-stop de otra app. Si el archivo existe, no arrancan con hardware y nunca lo
# borran. Por defecto: ~/.openclaw/workspace/ESTOP_LOCK
# ROSORIN_ESTOP_LOCK_FILE=

# API key de Gemini que el bridge le da a la web (GET /config/gemini-key, con token). Los lanzadores
# la cargan sola de web/.env (GEMINI_API_KEY); defínela aquí solo si levantas el bridge a mano. Nunca
# va en un argumento ni en el log, y no se le pasa al worker.
# GEMINI_API_KEY=

# Logs del puente (tracing). Ejemplo: rosorin_bridge=debug,tower_http=info
RUST_LOG=rosorin_bridge=info,tower_http=info
